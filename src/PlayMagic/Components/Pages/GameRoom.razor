@page "/game/{Id}"
@rendermode InteractiveServer
@implements IDisposable
@using PlayMagic.Data
@using PlayMagic.Services
@inject GameService Games
@inject GameNotifier Notifier
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ILogger<GameRoom> Logger

<PageTitle>Game @Id · Play Magic</PageTitle>

<main class="site-shell game-shell">
    <header class="site-header">
        <a class="brand" href="/">✦ Play Magic</a>
        <a class="header-note" href="/">← Back to home</a>
    </header>

    @if (loading)
    {
        <div class="center-panel">Opening game @Id…</div>
    }
    else if (info is null)
    {
        <div class="center-panel"><h1>Game not found</h1><p>Check the eight-character code and try again.</p><a class="primary-button" href="/">Back to home</a></div>
    }
    else if (view is null)
    {
        <section class="join-page">
            <div class="join-intro">
                <div class="eyebrow">JOIN THE TABLE</div>
                <h1>Game <em>@Id</em></h1>
                <p>@info.Format · @info.PlayerCount of 4 seats taken</p>
                <button class="outline-button" @onclick="CopyLink">Copy invite link ↗</button>
                @if (info.PlayerCount > 0)
                {
                    <button class="outline-button" @onclick="WatchGame">Watch as spectator</button>
                }
                <p class="small-note">Share the code or the page link with your friends.</p>
            </div>
            <div class="join-form">
                <h2>Take a seat</h2>
                <label for="player-name">Your name</label>
                <input id="player-name" maxlength="24" placeholder="What should we call you?" @bind="playerName" @bind:event="oninput" />
                <label for="deck-name">Deck name <small>(optional)</small></label>
                <input id="deck-name" maxlength="80" placeholder="What deck are you playing?" @bind="deckName" @bind:event="oninput" />
                @if (savedDecks.Count > 0)
                {
                    <label for="saved-deck">Use a saved deck</label>
                    <div class="saved-deck-row">
                        <select id="saved-deck" value="@selectedSavedDeck" @onchange="SelectSavedDeck">
                            <option value="">Choose a deck…</option>
                            @foreach (var deck in savedDecks) { <option value="@deck.Name">@deck.Name</option> }
                        </select>
                        <button class="outline-button" type="button" disabled="@(selectedSavedDeck.Length == 0)" @onclick="RemoveSavedDeck">Remove</button>
                    </div>
                }
                <label for="deck-text">Paste your deck list</label>
                <textarea id="deck-text" rows="9" placeholder="1 Sol Ring (one card per line)" @bind="deckText" @bind:event="oninput"></textarea>
                <p class="small-note">Copy a plain text list from <a href="https://www.moxfield.com" target="_blank" rel="noopener noreferrer">Moxfield</a>, <a href="https://archidekt.com" target="_blank" rel="noopener noreferrer">Archidekt</a>, <a href="https://www.mtggoldfish.com" target="_blank" rel="noopener noreferrer">MTGGoldfish</a>, or another deck builder. Sideboards and maybeboards are skipped.</p>
                <label class="save-deck-choice"><input type="checkbox" @bind="saveDeck" /> Save this deck in this browser for next time</label>
                @if (!string.IsNullOrWhiteSpace(error)) { <p class="message error">@error</p> }
                <button class="primary-button" disabled="@busy" @onclick="Join">@(busy ? "Importing deck…" : "Join game →")</button>
                <div class="transfer-claim">
                    <label for="transfer-code">Already have a seat transfer code?</label>
                    <div class="saved-deck-row">
                        <input id="transfer-code" maxlength="10" placeholder="TRANSFER CODE" @bind="transferCode" @bind:event="oninput" />
                        <button class="outline-button" type="button" disabled="@busy" @onclick="ClaimSeat">Claim seat</button>
                    </div>
                </div>
                <p class="small-note">Your seat stays in this browser. Your hand is visible only to you.</p>
            </div>
        </section>
    }
    else
    {
        <div class="game-toolbar">
            <div><div class="eyebrow">@view.Format GAME</div><h1>Table <span>@Id</span></h1></div>
            <div class="toolbar-actions">
                <span>@(view.IsSpectator ? "Spectating" : $"{view.Players.Count} / 4 players")</span>
                <details id="table-options-menu" class="table-menu">
                    <summary aria-label="Open table options" title="Table options"><span aria-hidden="true">•••</span></summary>
                    <div class="table-menu-list">
                        <button type="button" @onclick="CopyLink"><span>Copy invite link</span><small>For players joining the table</small></button>
                        <button type="button" @onclick="CopySpectatorLink"><span>Copy spectator link</span><small>Read-only view with private hands hidden</small></button>
                        @if (!view.IsSpectator && MyPlayer is not null)
                        {
                            <button type="button" disabled="@busy" @onclick="ExportGame"><span>Save game to file</span><small>Includes every player's private zones</small></button>
                            <button type="button" @onclick="CreateTransferCode"><span>Create transfer code</span><small>Move your seat to another device</small></button>
                            @if (generatedTransferCode is not null)
                            {
                                <div class="transfer-menu-result"><small>Expires in ten minutes</small><strong>@generatedTransferCode</strong></div>
                            }
                        }
                    </div>
                </details>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(error)) { <p class="message error">@error</p> }
        @if (restoredInvites is not null)
        {
            <section class="restored-invites" aria-labelledby="restored-invites-heading">
                <button class="close-button" type="button" aria-label="Dismiss restored game invitations" @onclick="DismissRestoredInvites">×</button>
                <div>
                    <div class="eyebrow">GAME RESTORED</div>
                    <h2 id="restored-invites-heading">New table, fresh invitations</h2>
                    <p>This table has a new game code. Send each private, single-use link to the named player. Links remain valid until claimed or this game expires; dismiss this panel after sharing them.</p>
                </div>
                @if (restoredInvites.Count == 0)
                {
                    <p class="small-note">You were the only player in the saved game, so no additional invitations are needed.</p>
                }
                else
                {
                    <div class="restored-invite-list">
                        @foreach (var invite in restoredInvites)
                        {
                            <div class="restored-invite-row">
                                <strong>@invite.PlayerName</strong>
                                <input aria-label="Restored seat invitation for @invite.PlayerName" readonly value="@RestoredInviteUrl(invite)" />
                                <button class="outline-button" type="button" @onclick="() => CopyRestoredInvite(invite)">Copy</button>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        <section class="table-tools @(view.IsSpectator ? "spectator-tools" : "")" aria-labelledby="table-tools-heading">
            <div class="table-tools-heading">
                <div class="eyebrow">TABLE TOOLS</div>
                <h2 id="table-tools-heading">Keep play moving</h2>
                <p>Turn order and shared chance.</p>
            </div>
            <div class="turn-tool">
                <div><span>TURN @view.TurnNumber</span><strong>@(view.Players.FirstOrDefault(player => player.Id == view.ActivePlayerId)?.Name ?? "No active player")</strong></div>
                @if (!view.IsSpectator)
                {
                    <div class="turn-actions">
                        <button @onclick="AdvanceTurn">Next turn</button>
                        @if (MyPlayer is not null && view.ActivePlayerId != view.MyPlayerId)
                        {
                            <button @onclick="() => TakeTurn(MyPlayer.Id)">Take turn</button>
                        }
                    </div>
                }
            </div>
            @if (!view.IsSpectator)
            {
            <div class="randomizer-tools">
                <div class="randomizer-tool">
                    <div class="randomizer-stage" aria-hidden="true">
                        @if (d20Result is null)
                        {
                            <div class="d20-shape idle"><span>20</span></div>
                        }
                        else
                        {
                            <div @key="d20Sequence" class="d20-shape rolling"><span>@d20Result</span></div>
                        }
                    </div>
                    <div class="randomizer-copy">
                        <span>D20</span>
                        <strong role="status" aria-live="polite">@(d20Result is null ? "Ready to roll" : $"Rolled {d20Result}")</strong>
                    </div>
                    <button type="button" disabled="@busy" @onclick="RollD20" aria-label="Roll a twenty-sided die">Roll d20</button>
                </div>
                <div class="randomizer-tool">
                    <div class="randomizer-stage coin-stage" aria-hidden="true">
                        @if (coinResult is null)
                        {
                            <div class="coin idle"><span>?</span></div>
                        }
                        else
                        {
                            <div @key="coinSequence" class="coin flipping @coinResult.ToLowerInvariant()">
                                <span class="coin-face coin-heads">H</span>
                                <span class="coin-face coin-tails">T</span>
                            </div>
                        }
                    </div>
                    <div class="randomizer-copy">
                        <span>COIN</span>
                        <strong role="status" aria-live="polite">@(coinResult is null ? "Ready to flip" : coinResult)</strong>
                    </div>
                    <button type="button" disabled="@busy" @onclick="FlipCoin">Flip coin</button>
                </div>
            </div>
            }
        </section>

        <section class="players-grid">
            @foreach (var player in view.Players.OrderBy(player => player.Id == view.MyPlayerId ? 1 : 0))
            {
                var isMe = player.Id == view.MyPlayerId;
                <article class="player-board @(isMe ? "my-board" : "") @(player.Id == view.ActivePlayerId ? "active-turn" : "")">
                    <div class="player-heading">
                        <div><span class="seat-tag">@(isMe ? "YOUR SEAT" : view.IsSpectator ? "PLAYER" : "OPPONENT")</span><h2>@player.Name @(player.Id == view.ActivePlayerId ? "✦" : "")</h2><small>@player.DeckName</small></div>
                        <div class="life-control">
                            @if (isMe) { <button aria-label="Lose one life" @onclick="() => ChangeLife(-1)">−</button> }
                            <strong>@player.Life</strong>
                            @if (isMe) { <button aria-label="Gain one life" @onclick="() => ChangeLife(1)">+</button> }
                            <span>LIFE</span>
                        </div>
                    </div>
                    <div class="player-meta">
                        <span>Library <b>@player.LibraryCount</b></span><span>Hand <b>@player.HandCount</b></span>
                        @foreach (var counter in player.Counters) { <span>@counter.Key <b>@counter.Value</b></span> }
                    </div>
                    @if (view.Format == "Commander" && isMe && view.Players.Count > 1)
                    {
                        <div class="commander-damage">
                            <span class="zone-title">COMMANDER DAMAGE</span>
                            @foreach (var opponent in view.Players.Where(item => item.Id != player.Id))
                            {
                                <div><span>@opponent.Name <b>@player.CommanderDamage.GetValueOrDefault(opponent.Id)</b></span><button @onclick="() => ChangeCommanderDamage(opponent.Id, -1)">−</button><button @onclick="() => ChangeCommanderDamage(opponent.Id, 1)">+</button></div>
                            }
                        </div>
                    }
                    @if (isMe)
                    {
                        <div class="player-actions"><button @onclick="Draw">Draw 1</button><button @onclick="Mill">Mill 1</button><button @onclick="RevealTop">Reveal top</button><button @onclick="Scry">Scry 1</button><button @onclick="Shuffle">Shuffle</button><button @onclick="Mulligan">Mulligan</button><input aria-label="Player counter name" placeholder="Counter name" @bind="playerCounterName" @bind:event="oninput" /><button @onclick="() => ChangePlayerCounter(1)">+ counter</button><button @onclick="() => ChangePlayerCounter(-1)">− counter</button></div>
                    }
                    <div class="battlefield drop-zone" @ondragover:preventDefault="true" @ondrop="() => Drop(CardZones.Battlefield)">
                        <div class="zone-title">BATTLEFIELD <span>Drop cards here</span></div>
                        <div class="cards-row">
                            @foreach (var card in player.Cards.Where(card => card.Zone == CardZones.Battlefield))
                            {
                                <div class="game-card @(card.Tapped ? "tapped" : "") @(selected?.Id == card.Id ? "active-card" : "")" data-card-id="@card.Id" draggable="@(isMe ? "true" : "false")" @onclick="() => Select(card)">
                                    @if (card.ImageUrl is not null) { <img src="@card.ImageUrl" alt="@card.Name" /> } else { <span>@card.Name</span> }
                                    @if (card.Counters.Count > 0) { <div class="card-counter-badges">@foreach (var counter in card.Counters) { <span>@counter.Key @counter.Value</span> }</div> }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="small-zones">
                        @foreach (var zone in VisibleSmallZones(view.Format))
                        {
                            <div class="small-zone drop-zone" @ondragover:preventDefault="true" @ondrop="() => Drop(zone)">
                                <div class="zone-title">@zone.ToUpperInvariant() <span>@player.Cards.Count(card => card.Zone == zone)</span></div>
                                <div class="cards-row">
                                    @foreach (var card in player.Cards.Where(card => card.Zone == zone))
                                    {
                                        <div class="game-card mini @(selected?.Id == card.Id ? "active-card" : "")" data-card-id="@card.Id" draggable="@(isMe ? "true" : "false")" @onclick="() => Select(card)">
                                            @if (card.ImageUrl is not null) { <img src="@card.ImageUrl" alt="@card.Name" /> } else { <span>@card.Name</span> }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </article>
            }
        </section>

        @if (MyPlayer is { } me)
        {
            <section class="hand-panel drop-zone" @ondragover:preventDefault="true" @ondrop="() => Drop(CardZones.Hand)">
                <div class="hand-heading"><div><span class="eyebrow">PRIVATE AREA</span><h2>Your hand <span>@me.HandCount</span></h2></div><div class="library-drop drop-zone" @ondragover:preventDefault="true" @ondrop:stopPropagation="true" @ondrop="() => Drop(CardZones.Library)">Drop here to put a card on top of your library</div></div>
                <div class="hand-cards">
                    @foreach (var card in me.Cards.Where(card => card.Zone == CardZones.Hand))
                    {
                        <div class="game-card hand-card @(selected?.Id == card.Id ? "active-card" : "")" data-card-id="@card.Id" draggable="true" @onclick="() => Select(card)">
                            @if (card.ImageUrl is not null) { <img src="@card.ImageUrl" alt="@card.Name" /> } else { <span>@card.Name</span> }
                        </div>
                    }
                </div>
            </section>
        }

        @if (selected is not null)
        {
            <aside class="card-inspector">
                <button class="close-button" aria-label="Close card details" @onclick="() => selected = null">×</button>
                @if (selected.ImageUrl is not null) { <img src="@selected.ImageUrl" alt="@selected.Name" /> }
                <div><div class="eyebrow">CARD DETAILS</div><h2>@selected.Name</h2><p>@selected.TypeLine</p><p class="oracle-text">@selected.OracleText</p>
                    @if (selected.BackImageUrl is not null) { <a href="@selected.BackImageUrl" target="_blank" rel="noopener">View back face ↗</a> }
                    @if (IsMyCard)
                    {
                        <div class="inspector-actions">
                            @if (selected.Zone == CardZones.Battlefield) { <button @onclick="TapSelected">@(selected.Tapped ? "Untap" : "Tap")</button> }
                            @foreach (var zone in CardDestinations(view.Format).Where(zone => zone != CardZones.Library))
                            {
                                if (zone != selected.Zone) { <button @onclick="() => MoveSelected(zone)">To @zone</button> }
                            }
                            @if (selected.Zone != CardZones.Library)
                            {
                                <button @onclick="() => MoveSelected(CardZones.Library, LibraryPlacement.Top)">Top of library</button>
                                <button @onclick="() => MoveSelected(CardZones.Library, LibraryPlacement.Bottom)">Bottom of library</button>
                            }
                        </div>
                        <div class="counter-editor"><input aria-label="Card counter name" placeholder="Counter name (e.g. +1/+1)" @bind="cardCounterName" @bind:event="oninput" /><button @onclick="() => ChangeCardCounter(1)">+</button><button @onclick="() => ChangeCardCounter(-1)">−</button></div>
                        @foreach (var counter in selected.Counters) { <span class="counter-pill">@counter.Key: @counter.Value</span> }
                    }
                </div>
            </aside>
        }
        @if (scryCard is not null)
        {
            <aside class="card-inspector scry-inspector">
                <button class="close-button" aria-label="Close scry" @onclick="() => scryCard = null">×</button>
                @if (scryCard.ImageUrl is not null) { <img src="@scryCard.ImageUrl" alt="@scryCard.Name" /> }
                <div><div class="eyebrow">SCRY 1</div><h2>@scryCard.Name</h2><p>@scryCard.TypeLine</p><p class="oracle-text">@scryCard.OracleText</p>
                    <div class="inspector-actions"><button @onclick="KeepScryOnTop">Keep on top</button><button @onclick="PutScryOnBottom">Put on bottom</button></div>
                </div>
            </aside>
        }
        <details class="activity-footer">
            <summary>
                <span>Recent activity</span>
                <small>@(view.Events.FirstOrDefault()?.Message ?? "No table actions yet.")</small>
            </summary>
            <div class="activity-log" aria-live="polite">
                @foreach (var item in view.Events.Take(8))
                {
                    <div class="activity-item"><span>@item.Kind</span><p>@item.Message</p></div>
                }
            </div>
        </details>
    }
    @if (toastMessage is not null)
    {
        <div @key="toastVersion" class="toast-notification @(toastIsError ? "error" : "")"
             role="@(toastIsError ? "alert" : "status")" aria-live="polite">@toastMessage</div>
    }
    <footer>Card data and images by <a href="https://scryfall.com" target="_blank" rel="noopener">Scryfall</a>.</footer>
</main>

@code {
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery] public bool Spectate { get; set; }
    [SupplyParameterFromQuery(Name = "claim")] public string? ClaimCode { get; set; }
    private GameInfo? info;
    private GameView? view;
    private CardView? selected;
    private CardView? scryCard;
    private IDisposable? subscription;
    private string? token;
    private string playerName = "";
    private string deckName = "";
    private string deckText = "";
    private string transferCode = "";
    private string? generatedTransferCode;
    private List<RestoredSeatInvite>? restoredInvites;
    private List<SavedDeck> savedDecks = [];
    private string selectedSavedDeck = "";
    private bool saveDeck;
    private string playerCounterName = "Poison";
    private string cardCounterName = "+1/+1";
    private string error = "";
    private bool busy;
    private bool loading = true;
    private int? d20Result;
    private string? coinResult;
    private int d20Sequence;
    private int coinSequence;
    private string? toastMessage;
    private int toastVersion;
    private bool toastIsError;
    private bool disposed;
    private bool refreshRequested;
    private bool refreshing;
    private PlayerView? MyPlayer => view?.Players.FirstOrDefault(player => player.Id == view.MyPlayerId);
    private bool IsMyCard => selected is not null && MyPlayer?.Cards.Any(card => card.Id == selected.Id) == true;

    protected override async Task OnParametersSetAsync()
    {
        Id = Id.Trim().ToUpperInvariant();
        info = await Games.GetInfoAsync(Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        token = await JS.InvokeAsync<string?>("playMagic.getToken", Id);
        savedDecks = await JS.InvokeAsync<List<SavedDeck>>("playMagic.getSavedDecks");
        if (!Spectate && token is null && !string.IsNullOrWhiteSpace(ClaimCode))
        {
            var result = await JS.InvokeAsync<GameApiResponse>("playMagic.post",
                $"/api/games/{Uri.EscapeDataString(Id)}/claim-seat", new { transferCode = ClaimCode });
            if (result.Value is not null)
            {
                token = result.Value;
                await JS.InvokeVoidAsync("playMagic.setToken", Id, token);
                Navigation.NavigateTo($"/game/{Uri.EscapeDataString(Id)}", replace: true);
            }
            else error = result.Error ?? "Could not claim that restored seat.";
        }
        if (Spectate) view = await Games.GetSpectatorViewAsync(Id);
        else if (token is not null) view = await Games.GetViewAsync(Id, token);
        if (view is not null && !view.IsSpectator)
            restoredInvites = await JS.InvokeAsync<List<RestoredSeatInvite>?>("playMagic.getRestoredInvites", Id);
        subscription = Notifier.Subscribe(Id, QueueRefresh);
        loading = false;
        StateHasChanged();
    }

    private async Task Join()
    {
        busy = true;
        error = "";
        try
        {
            var result = await JS.InvokeAsync<GameApiResponse>("playMagic.post", $"/api/games/{Uri.EscapeDataString(Id)}/join",
                new { playerName, deckText, deckName });
            if (result.Value is null)
            {
                error = result.Error ?? "Could not join this game. Please try again.";
                return;
            }
            token = result.Value;
            await JS.InvokeVoidAsync("playMagic.setToken", Id, token);
            if (saveDeck)
                savedDecks = await JS.InvokeAsync<List<SavedDeck>>("playMagic.saveDeck", deckName, deckText);
            await Refresh();
        }
        catch (JSException) { error = "Could not join this game. Please try again."; }
        catch (Exception exception) { Logger.LogError(exception, "Could not join game {GameId}", Id); error = "Could not join this game. Please try again."; }
        finally { busy = false; }
    }

    private async Task ClaimSeat()
    {
        busy = true;
        error = "";
        try
        {
            var result = await JS.InvokeAsync<GameApiResponse>("playMagic.post",
                $"/api/games/{Uri.EscapeDataString(Id)}/claim-seat", new { transferCode });
            if (result.Value is null) { error = result.Error ?? "Could not claim that seat."; return; }
            token = result.Value;
            Spectate = false;
            await JS.InvokeVoidAsync("playMagic.setToken", Id, token);
            await Refresh();
        }
        catch (JSException) { error = "Could not claim that seat. Please try again."; }
        finally { busy = false; }
    }

    private void SelectSavedDeck(ChangeEventArgs args)
    {
        selectedSavedDeck = args.Value?.ToString() ?? "";
        var saved = savedDecks.FirstOrDefault(deck => deck.Name == selectedSavedDeck);
        if (saved is null) return;
        deckName = saved.Name;
        deckText = saved.Text;
    }

    private async Task RemoveSavedDeck()
    {
        savedDecks = await JS.InvokeAsync<List<SavedDeck>>("playMagic.removeSavedDeck", selectedSavedDeck);
        selectedSavedDeck = "";
    }

    private sealed record SavedDeck(string Name, string Text);

    private async Task Refresh()
    {
        if (Spectate) { view = await Games.GetSpectatorViewAsync(Id); return; }
        if (token is null) { info = await Games.GetInfoAsync(Id); return; }
        view = await Games.GetViewAsync(Id, token);
        if (selected is not null)
            selected = view?.Players.SelectMany(player => player.Cards).FirstOrDefault(card => card.Id == selected.Id);
    }

    private void QueueRefresh()
    {
        if (disposed) return;
        _ = InvokeAsync(async () =>
        {
            refreshRequested = true;
            if (refreshing) return;
            refreshing = true;
            try
            {
                while (refreshRequested && !disposed)
                {
                    refreshRequested = false;
                    await Refresh();
                    StateHasChanged();
                }
            }
            catch (Exception exception) when (!disposed)
            {
                Logger.LogWarning(exception, "Could not refresh game {GameId}", Id);
            }
            finally { refreshing = false; }
        });
    }

    private Task CopyLink() => CopyToClipboard(
        $"{Navigation.BaseUri.TrimEnd('/')}/game/{Uri.EscapeDataString(Id)}", "Invite link copied");
    private Task CopySpectatorLink() => CopyToClipboard(
        $"{Navigation.BaseUri.TrimEnd('/')}/game/{Uri.EscapeDataString(Id)}?spectate=true", "Spectator link copied");

    private async Task CopyToClipboard(string url, string confirmation)
    {
        try
        {
            await JS.InvokeVoidAsync("playMagic.copyLink", url, "table-options-menu");
            await ShowToast(confirmation);
        }
        catch (JSException)
        {
            await ShowToast("Could not copy the link", isError: true);
        }
    }

    private async Task ExportGame()
    {
        if (token is null || !await JS.InvokeAsync<bool>("playMagic.confirm",
                "The save file contains the full table, including every player's hidden hand and library. Download it anyway?"))
            return;
        busy = true;
        error = "";
        try
        {
            var archive = await Games.ExportAsync(Id, token);
            var filename = $"playmagic-{Id}-{DateTime.UtcNow:yyyyMMdd-HHmm}.playmagic";
            await JS.InvokeVoidAsync("playMagic.downloadText", filename, archive);
            await ShowToast("Game save downloaded");
        }
        catch (GameActionException exception) { error = exception.Message; }
        catch (JSException) { error = "Could not download the game save."; }
        finally { busy = false; }
    }

    private string RestoredInviteUrl(RestoredSeatInvite invite) =>
        $"{Navigation.BaseUri.TrimEnd('/')}/game/{Uri.EscapeDataString(Id)}?claim={Uri.EscapeDataString(invite.Code)}";

    private Task CopyRestoredInvite(RestoredSeatInvite invite) =>
        CopyToClipboard(RestoredInviteUrl(invite), $"Invite for {invite.PlayerName} copied");

    private async Task DismissRestoredInvites()
    {
        if (restoredInvites is { Count: > 0 } && !await JS.InvokeAsync<bool>("playMagic.confirm",
                "Dismiss these invitations? They cannot be recovered after they leave this browser."))
            return;
        await JS.InvokeVoidAsync("playMagic.removeRestoredInvites", Id);
        restoredInvites = null;
    }

    private async Task ShowToast(string message, bool isError = false)
    {
        var version = ++toastVersion;
        toastMessage = message;
        toastIsError = isError;
        StateHasChanged();
        await Task.Delay(TimeSpan.FromSeconds(2.5));
        if (disposed || version != toastVersion) return;
        toastMessage = null;
        StateHasChanged();
    }
    private void WatchGame() => Navigation.NavigateTo($"/game/{Uri.EscapeDataString(Id)}?spectate=true", forceLoad: true);
    private async Task Drop(string zone)
    {
        var cardId = await JS.InvokeAsync<string?>("playMagic.getDraggedCardId");
        if (cardId is null) return;
        await Act(() => Games.MoveCardAsync(Id, token!, cardId, zone));
        await JS.InvokeVoidAsync("playMagic.clearDraggedCardId");
    }
    private void Select(CardView card) => selected = card;
    private Task Draw() => Act(() => Games.DrawAsync(Id, token!));
    private Task Mill() => Act(() => Games.MillAsync(Id, token!));
    private Task RevealTop() => Act(() => Games.RevealTopAsync(Id, token!));
    private Task Shuffle() => Act(() => Games.ShuffleAsync(Id, token!));
    private async Task Mulligan()
    {
        if (await JS.InvokeAsync<bool>("playMagic.confirm", "Shuffle every card you own into your library and draw seven?"))
            await Act(() => Games.MulliganAsync(Id, token!));
    }
    private async Task Scry()
    {
        error = "";
        try { scryCard = await Games.ScryAsync(Id, token!); if (scryCard is null) error = "Your library is empty."; }
        catch (GameActionException exception) { error = exception.Message; }
    }
    private Task KeepScryOnTop() { scryCard = null; return Task.CompletedTask; }
    private async Task PutScryOnBottom()
    {
        if (scryCard is null) return;
        var card = scryCard;
        scryCard = null;
        await Act(() => Games.MoveCardAsync(Id, token!, card.Id, CardZones.Library, LibraryPlacement.Bottom));
    }
    private Task ChangeLife(int delta) => Act(() => Games.AdjustLifeAsync(Id, token!, delta));
    private Task ChangePlayerCounter(int delta) => Act(() => Games.AdjustPlayerCounterAsync(Id, token!, playerCounterName, delta));
    private Task ChangeCardCounter(int delta) => selected is null ? Task.CompletedTask : Act(() => Games.AdjustCardCounterAsync(Id, token!, selected.Id, cardCounterName, delta));
    private Task ChangeCommanderDamage(string sourcePlayerId, int delta) => Act(() => Games.AdjustCommanderDamageAsync(Id, token!, sourcePlayerId, delta));
    private Task TapSelected() => selected is null ? Task.CompletedTask : Act(() => Games.ToggleTappedAsync(Id, token!, selected.Id));
    private Task MoveSelected(string zone, LibraryPlacement placement = LibraryPlacement.Top) => selected is null ? Task.CompletedTask : Act(() => Games.MoveCardAsync(Id, token!, selected.Id, zone, placement));
    private async Task RollD20()
    {
        await Act(async () => d20Result = await Games.RollDieAsync(Id, token!, 20));
        d20Sequence++;
    }

    private async Task FlipCoin()
    {
        await Act(async () => coinResult = await Games.FlipCoinAsync(Id, token!));
        coinSequence++;
    }
    private Task AdvanceTurn() => Act(() => Games.AdvanceTurnAsync(Id, token!));
    private Task TakeTurn(string playerId) => Act(() => Games.SetActivePlayerAsync(Id, token!, playerId));
    private async Task CreateTransferCode()
    {
        error = "";
        try { generatedTransferCode = await Games.CreateSeatTransferAsync(Id, token!); }
        catch (GameActionException exception) { error = exception.Message; }
    }

    private static IEnumerable<string> VisibleSmallZones(string format) => format == "Commander"
        ? [CardZones.Graveyard, CardZones.Exile, CardZones.Commander]
        : [CardZones.Graveyard, CardZones.Exile];

    private static IEnumerable<string> CardDestinations(string format) => format == "Commander"
        ? [CardZones.Battlefield, CardZones.Hand, CardZones.Library, CardZones.Graveyard, CardZones.Exile, CardZones.Commander]
        : [CardZones.Battlefield, CardZones.Hand, CardZones.Library, CardZones.Graveyard, CardZones.Exile];

    private async Task Act(Func<Task> action)
    {
        error = "";
        try { await action(); await Refresh(); }
        catch (GameActionException exception) { error = exception.Message; }
    }

    public void Dispose()
    {
        disposed = true;
        subscription?.Dispose();
    }

}
